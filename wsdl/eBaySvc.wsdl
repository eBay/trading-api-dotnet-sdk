							<Returned>Conditionally</Returned>
						</CallInfo>
						<CallInfo>
							<CallName>GetSellerTransactions</CallName>
							<Details>DetailLevel: none, ReturnAll, ItemReturnDescription</Details>
							<Returned>Conditionally</Returned>
						</CallInfo>
						<CallInfo>
							<CallName>GetSellerList</CallName>
