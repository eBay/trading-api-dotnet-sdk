								<Context>WonList</Context>
								<Context>DeletedFromWonList</Context>
								<Details>DetailLevel: none, ReturnAll</Details>
								<Returned>Conditionally</Returned>
							</CallInfo>
						</xs:appinfo>
					</xs:annotation>
				</xs:attribute>
		 </xs:extension>
	 </xs:simpleContent>
</xs:complexType>
