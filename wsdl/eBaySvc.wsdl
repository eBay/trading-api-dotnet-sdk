					</xs:documentation>
					<xs:appinfo>
						<CallInfo>
							<CallName>GeteBayDetails</CallName>
							<Returned>Conditionally</Returned>
						</CallInfo>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
