					</xs:documentation>
					<xs:appinfo>
						<CallInfo>
							<CallName>GetUser</CallName>
							<Details>DetailLevel: none, ReturnSummary, ReturnAll</Details>
							<Returned>Conditionally</Returned>
						</CallInfo>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="AffiliationType" type="ns:CharityAffiliationTypeCodeType" minOccurs="0">
