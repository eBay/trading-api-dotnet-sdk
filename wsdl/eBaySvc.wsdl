						</CallInfo>
						<SeeLink>
							<URL>https://developer.ebay.com/api-docs/user-guides/static/trading-user-guide/shipping-flat-rate.html#max-flat</URL>
							<Title>Flat rate shipping</Title>
						</SeeLink>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
