					<xs:documentation>
						This value indicates that an unpaid order can be combined into a Combined Invoice
						order within 30 days after purchase (creation of order).
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Ineligible">
