						"New: with Tags" in one category and "Brand New" in another.
					</xs:documentation>
					<xs:appinfo>
						<CallInfo>
							<CallName>GetCategoryFeatures</CallName>
							<Details>DetailLevel: ReturnAll</Details>
							<Returned>Conditionally</Returned>
						</CallInfo>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
