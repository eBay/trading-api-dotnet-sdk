					<xs:documentation>
						This enumeration value indicates that the account entry is a fee charged by eBay when the seller sets a reserve price for an auction listing.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CreditReserve">
