					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Disabled">
				<xs:annotation>
					<xs:documentation>
						This enumeration value indicates that the Featured First listing upgrade is not available for any sellers on the site.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PowerSellerOnly">
				<xs:annotation>
					<xs:documentation>
